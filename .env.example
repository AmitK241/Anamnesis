# Anamnesis — Environment Configuration
# Copy this file to .env and fill in your values

# ── DataHub ────────────────────────────────────────────────────────────────
# URL of your DataHub GMS server (default: local quickstart)
DATAHUB_GMS_SERVER=http://localhost:8080

# Personal Access Token for DataHub (leave blank if auth is disabled locally)
# Generate at: DataHub → Settings → Access Tokens → Generate New Token
DATAHUB_GMS_TOKEN=

# ── Groq LLM (Fixer agent) ─────────────────────────────────────────────────
# Required for the /api/fix endpoint and verify_fixer.py
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: override the default Groq model (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: LLM sampling temperature (default: 0.3)
# GROQ_TEMPERATURE=0.3

# ── Anamnesis Settings ─────────────────────────────────────────────────────
# Pipe-separated list of dataset URNs to scan for IncidentMemory aspects
# Used by verify_recall.py when DataHub is connected
# ANAMNESIS_KNOWN_DATASET_URNS=urn:li:dataset:(...)|urn:li:dataset:(...)
